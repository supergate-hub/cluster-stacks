{
  "type": "object",
  "required": true,
  "defaultValue": {},
  "viewSpec": {
    "type": "base",
    "order": [
      "targetCluster",
      "general",
      "configuration",
      "setup"
    ]
  },
  "properties": {
    "targetCluster": {
      "type": "object",
      "required": true,
      "viewSpec": {
        "type": "cluster_select",
        "layoutTitle": "Kubernetes cluster"
      }
    },
    "general": {
      "type": "object",
      "required": true,
      "defaultValue": {},
      "viewSpec": {
        "type": "base",
        "layout": "section",
        "layoutTitle": "General"
      },
      "properties": {
        "appname": {
          "type": "string",
          "required": true,
          "defaultValue": "argo-cd",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "patternError": "Use lower-case letters, numbers, and hyphens; start and end with a letter or number.",
          "viewSpec": {
            "type": "base",
            "layout": "row",
            "layoutTitle": "Application name"
          }
        },
        "namespace": {
          "type": "string",
          "required": true,
          "defaultValue": "argo-cd",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "patternError": "Use lower-case letters, numbers, and hyphens; start and end with a letter or number.",
          "viewSpec": {
            "type": "base",
            "layout": "row",
            "layoutTitle": "Namespace"
          }
        },
        "adminPassword": {
          "type": "string",
          "required": false,
          "pattern": "^$|^.{12,}$",
          "patternError": "Leave empty or use at least 12 characters.",
          "viewSpec": {
            "type": "password",
            "layout": "row",
            "layoutTitle": "Administrator password",
            "layoutDescription": "Leave empty to use Argo CD's generated initial password. A supplied password is stored only as a bcrypt hash.",
            "generateRandomValueButton": true
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "required": true,
      "defaultValue": {},
      "viewSpec": {
        "type": "base",
        "layout": "section",
        "layoutTitle": "Controllers"
      },
      "properties": {
        "notificationsEnabled": {
          "type": "boolean",
          "required": true,
          "defaultValue": false,
          "viewSpec": {
            "type": "switch",
            "layout": "row",
            "layoutTitle": "Notifications controller",
            "layoutDescription": "Install notification processing; destinations are configured after installation."
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "required": true,
      "defaultValue": {},
      "viewSpec": {
        "type": "base",
        "layout": "section",
        "layoutTitle": "Advanced configuration"
      },
      "properties": {
        "compose": {
          "type": "object",
          "required": true,
          "defaultValue": {},
          "viewSpec": {
            "type": "base"
          },
          "properties": {
            "data": {
              "type": "string",
              "required": true,
              "defaultValue": "{}\n",
              "viewSpec": {
                "type": "yaml_input",
                "layout": "row",
                "layoutTitle": "Helm values",
                "inputProps": {
                  "buttonText": "Customize values",
                  "dialogTitle": "Argo CD Helm values",
                  "description": "Edit only the values you want to override. Guided settings take precedence.",
                  "sourcePath": "chart/values.yaml",
                  "editMode": "overrides"
                }
              }
            }
          }
        }
      }
    }
  }
}
