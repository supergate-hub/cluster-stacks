{
  "type": "object",
  "required": true,
  "defaultValue": {},
  "viewSpec": {
    "type": "base",
    "order": [
      "targetCluster",
      "general",
      "configuration"
    ]
  },
  "properties": {
    "targetCluster": {
      "type": "object",
      "required": true,
      "viewSpec": {
        "type": "cluster_select",
        "layoutTitle": "Kubernetes cluster"
      }
    },
    "general": {
      "type": "object",
      "required": true,
      "defaultValue": {},
      "viewSpec": {
        "type": "base",
        "layout": "section",
        "layoutTitle": "General"
      },
      "properties": {
        "appname": {
          "type": "string",
          "required": true,
          "defaultValue": "headlamp",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "patternError": "Use lower-case letters, numbers, and hyphens; start and end with a letter or number.",
          "viewSpec": {
            "type": "base",
            "layout": "row",
            "layoutTitle": "Application name"
          }
        },
        "namespace": {
          "type": "string",
          "required": true,
          "defaultValue": "headlamp",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "patternError": "Use lower-case letters, numbers, and hyphens; start and end with a letter or number.",
          "viewSpec": {
            "type": "base",
            "layout": "row",
            "layoutTitle": "Namespace"
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "required": true,
      "defaultValue": {},
      "viewSpec": {
        "type": "base",
        "layout": "section",
        "layoutTitle": "Access"
      },
      "properties": {
        "clusterRoleName": {
          "type": "string",
          "required": true,
          "defaultValue": "view",
          "enum": [
            "view",
            "cluster-admin"
          ],
          "enumNames": [
            "Read-only (recommended)",
            "Full cluster administration"
          ],
          "viewSpec": {
            "type": "select",
            "layout": "row",
            "layoutTitle": "Cluster access",
            "layoutDescription": "Creates a ClusterRoleBinding for the Headlamp service account."
          }
        }
      }
    }
  }
}
