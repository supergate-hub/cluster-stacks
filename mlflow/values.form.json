{
  "type": "object",
  "required": true,
  "defaultValue": {},
  "viewSpec": {
    "type": "base",
    "order": ["authentication", "storage"]
  },
  "properties": {
    "authentication": {
      "type": "object",
      "required": true,
      "defaultValue": {},
      "viewSpec": {
        "type": "base",
        "layout": "section",
        "layoutTitle": "Authentication",
        "order": ["adminUsername"]
      },
      "properties": {
        "adminUsername": {
          "type": "string",
          "required": true,
          "defaultValue": "admin",
          "pattern": "^[A-Za-z0-9._-]+$",
          "patternError": "Use letters, numbers, dots, underscores, or hyphens.",
          "viewSpec": {
            "type": "base",
            "layout": "row",
            "layoutTitle": "Administrator username",
            "layoutDescription": "The initial password is generated in the target cluster and is never accepted by this form."
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": true,
      "defaultValue": {},
      "viewSpec": {
        "type": "base",
        "layout": "section",
        "layoutTitle": "Storage",
        "order": ["storageClassName", "databaseStorageSize", "artifactStorageSize"]
      },
      "properties": {
        "storageClassName": {
          "type": "string",
          "required": false,
          "defaultValue": "",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "patternError": "Enter a valid StorageClass name or leave the field empty to use the cluster default.",
          "viewSpec": {
            "type": "base",
            "layout": "row",
            "layoutTitle": "StorageClass",
            "layoutDescription": "Leave empty to use the cluster's default StorageClass."
          }
        },
        "databaseStorageSize": {
          "type": "string",
          "required": true,
          "defaultValue": "8Gi",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
          "patternError": "Use a positive Kubernetes binary quantity such as 8Gi.",
          "viewSpec": {
            "type": "base",
            "layout": "row",
            "layoutTitle": "Database volume size"
          }
        },
        "artifactStorageSize": {
          "type": "string",
          "required": true,
          "defaultValue": "20Gi",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
          "patternError": "Use a positive Kubernetes binary quantity such as 20Gi.",
          "viewSpec": {
            "type": "base",
            "layout": "row",
            "layoutTitle": "Artifact volume size"
          }
        }
      }
    }
  }
}
